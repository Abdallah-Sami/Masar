# Local runs only. Copy to .env and NEVER commit .env.
# On GitHub, put these in Settings -> Secrets and variables -> Actions.
MASAR_DATA_DIR=./data
MASAR_SITE_DIR=./site
PROXY_ENABLED=false
PROXY_HOST=
PROXY_PORT=
PROXY_USER=
PROXY_PASS=
# Optional caps per run
TANQEEB_MAX_JOBS=300
WUZZUF_MAX_JOBS=300
SABBAR_MAX_JOBS=900
